{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Moxie",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/moxie.desktop"
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/moxie.desktop",
        "recommends": [
          "libayatana-appindicator-gtk3",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
