{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moxie",
  "mainBinaryName": "Moxie",
  "version": "1.3.12",
  "identifier": "com.moxie.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Moxie",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": [
          "'self'",
          "'unsafe-inline'",
          "'wasm-unsafe-eval'",
          "data:",
          "blob:",
          "textus-plugin:",
          "http://textus-plugin.localhost"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "data:",
          "textus-plugin:",
          "http://textus-plugin.localhost"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "textus-plugin:",
          "http://textus-plugin.localhost",
          "https:",
          "http:"
        ],
        "font-src": [
          "'self'",
          "data:",
          "asset:",
          "http://asset.localhost",
          "textus-plugin:",
          "http://textus-plugin.localhost"
        ],
        "media-src": [
          "'self'",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "textus-plugin:",
          "http://textus-plugin.localhost"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "textus-plugin:",
          "http://textus-plugin.localhost"
        ],
        "worker-src": [
          "'self'",
          "data:",
          "blob:",
          "textus-plugin:",
          "http://textus-plugin.localhost"
        ],
        "frame-src": ["'self'", "https:", "http:"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"]
      },
      "dangerousDisableAssetCspModification": ["script-src", "style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 kelongyan. Based on Textus, © 2026 CatVinci Studio (MIT)",
    "publisher": "Moxie",
    "homepage": "https://github.com/kelongyan/Moxie",
    "license": "MIT",
    "longDescription": "Moxie - a Markdown editor for Windows, built on Textus.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGQjI1MzU1RkRGODBDNkIKUldSckRQajlWVk95Yjc1VDNTZktOOUlSYy85aDlLLzZnNUJQdG1VamwzTDRvby81eWZKOG1GTmsK",
      "endpoints": [
        "https://github.com/kelongyan/Moxie/releases/latest/download/moxie-latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["moxie"]
      }
    }
  }
}
