{
  "name": "moxie",
  "version": "1.5.0",
  "description": "Moxie Markdown Editor",
  "author": "kelongyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kelongyan/Moxie.git"
  },
  "homepage": "https://github.com/kelongyan/Moxie#readme",
  "bugs": {
    "url": "https://github.com/kelongyan/Moxie/issues"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "build:mobile": "vite build --config vite.mobile.config.mjs",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:ios": "npm run build:mobile && cap sync ios && cap open ios",
    "cap:android": "npm run build:mobile && cap sync android && cap open android",
    "dist:android": "npm run build:mobile && cap sync android && cd android && gradlew.bat assembleRelease",
    "dist:android:debug": "npm run build:mobile && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-file-picker": "^8.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.6.5",
    "chokidar": "^4.0.3",
    "mermaid": "^11.15.0",
    "micromark-util-decode-string": "^2.0.1",
    "remark-frontmatter": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.moxie.app",
    "productName": "Moxie",
    "files": [
      "out/**/*"
    ],
    "icon": "build/icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "kelongyan",
        "repo": "Moxie"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Moxie Markdown Document",
          "role": "Editor"
        },
        {
          "ext": "markdown",
          "name": "Moxie Markdown Document",
          "role": "Editor"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Moxie.Markdown",
          "description": "Moxie Markdown Document",
          "role": "Editor",
          "icon": "build/file-icon.ico"
        },
        {
          "ext": "markdown",
          "name": "Moxie.Markdown",
          "description": "Moxie Markdown Document",
          "role": "Editor",
          "icon": "build/file-icon.ico"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "icon.png",
      "category": "Office",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Moxie Markdown Document",
          "role": "Editor"
        },
        {
          "ext": "markdown",
          "name": "Moxie Markdown Document",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
